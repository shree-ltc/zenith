# =================================================================
#  ZENITH BOT - ENVIRONMENT CONFIGURATION
# =================================================================

# Discord Bot Token (Required) - Obtain from Discord Developer Portal
BOT_TOKEN=your_bot_token_here

# Default Command Trigger Prefix
BOT_PREFIX=z!

# Bot Identity & Branding
BOT_NAME=Zenith
SUPPORT_SERVER=https://discord.gg/zenith
WEBSITE=https://github.com/shree-ltc/zenith

# Comma-separated Discord User IDs of Bot Developers
OWNER_IDS=1465912900710305822

# -----------------------------------------------------------------
#  STORAGE & CACHING (Optional - Defaults to SQLite & Local Memory)
# -----------------------------------------------------------------
# PostgreSQL Connection URL (e.g., postgresql://user:pass@localhost:5432/zenith)
# Leave blank to automatically use local SQLite storage
POSTGRES_URL=

# Redis Connection URL (e.g., redis://localhost:6379/0)
# Leave blank to automatically use local in-memory TTL caching
REDIS_URL=

# -----------------------------------------------------------------
#  INTERFACE & LIMITS
# -----------------------------------------------------------------
COLOR_PRIMARY=5865F2
COLOR_SUCCESS=57F287
COLOR_ERROR=ED4245
COLOR_WARNING=FEE75C

# Antinuke Default Punishment (ban / kick)
ANTINUKE_PUNISHMENT=ban

# Maximum messages allowed in a single purge command
MAX_PURGE_LIMIT=500
